FROM nginx:alpine

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy static and media files from the project
# Note: In a production CI/CD, these would usually be collected via 'python manage.py collectstatic'
# and then copied into this image.
COPY static /usr/share/nginx/html/static
COPY media /usr/share/nginx/html/media

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
